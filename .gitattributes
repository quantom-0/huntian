# Normalize every text file to LF inside the repository, independent of the
# local `core.autocrlf` setting (which is `true` on this Windows machine and
# would otherwise rewrite the whole tree to CRLF on checkout).
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
*.pptx binary

# Generated / vendored data is diffed by content, not by line.
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
